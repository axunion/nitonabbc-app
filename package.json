{
  "name": "nitonabbc-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "tsc -b && vite build",
    "serve": "vite preview",
    "check": "biome check && tsc -b --noEmit",
    "fix": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply nitonabbc-db --local",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply nitonabbc-db --local",
    "db:seed": "wrangler d1 execute nitonabbc-db --local --file=./scripts/seed.sql",
    "db:fresh": "pnpm db:reset && pnpm db:seed"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/router": "^1.0.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "lucide-solid": "^1.67.0",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@google/design.md": "^0.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.2.2",
    "lightningcss": "^1.33.0",
    "playwright": "^1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0",
    "yaml": "^2.9.1"
  }
}
