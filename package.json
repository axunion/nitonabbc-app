{
	"name": "nitonabbc-app",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.16.0",
			"onFail": "warn"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "11.5.1",
			"onFail": "warn"
		}
	},
	"scripts": {
		"prepare": "lefthook install",
		"dev": "vite",
		"dev:api": "wrangler dev",
		"build": "tsc -b && vite build",
		"serve": "vite preview",
		"check": "biome check ./src ./server ./worker",
		"fix": "biome check --write ./src ./server ./worker",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@kobalte/core": "^0.13.11",
		"@solid-primitives/i18n": "^2.2.1",
		"@solidjs/router": "^0.15.4",
		"hono": "^4.11.9",
		"lucide-solid": "^0.575.0",
		"solid-js": "^1.9.10"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@cloudflare/vite-plugin": "^1.25.6",
		"@cloudflare/workers-types": "^4.20260228.1",
		"@types/node": "^24.10.1",
		"lefthook": "^2.1.9",
		"lightningcss": "^1.31.1",
		"typescript": "~5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-pwa": "^1.2.0",
		"vite-plugin-solid": "^2.11.10",
		"vitest": "^4.0.18",
		"wrangler": "^4.69.0"
	}
}
