{
  "name": "nitonabbc-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check ./src",
    "check:write": "biome check --write ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler pages deploy dist",
    "preview:cf": "wrangler pages dev dist"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "hono": "^4.11.9",
    "solid-js": "^1.9.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@types/node": "^24.10.1",
    "lightningcss": "^1.31.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.0.18",
    "wrangler": "^4.65.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}